# Makefile for APB Decoder Generator -- VCS simulation
# (Bug #9 fix: the header used to be copy-pasted from an unrelated
# "RISC-V RV32I Single-Cycle CPU Testbench" project, and TB_LOCAL/TEST_DIR
# were referenced but never defined anywhere in this repo.)

# Directories
# Folder of the generated files; override for an example:
#   make run RTL_DIR=$(APB_DEC_GEN_HOME)/examples/ex_reg_in_out/output
RTL_DIR    ?= $(APB_DEC_GEN_HOME)/output
SIM_ROOT   := $(APB_DEC_GEN_HOME)/sim
SIM_DIR    := $(shell pwd)

# Compiler
VCS = vcs

# Resolved module name, written by apb_dec_rtl_generator.py (Bug #8 fix).
MODULE_NAME = $(shell cat $(RTL_DIR)/.module_name 2>/dev/null || echo m_vlsit_apbdec)

# Source file lists
RTL_FILELIST  = $(RTL_DIR)/filelist.f
TB_LIB_SRCS   = $(SIM_ROOT)/lib/apb_protocol_checker.sv \
                $(SIM_ROOT)/lib/apb_slave_bfm.sv \
                $(SIM_ROOT)/lib/apb_master_bfm.sv
# RTL_FILELIST (generated by `make tb` at the project root) already lists
# both the DUT and the testbench top-level; TB_LIB_SRCS only has to add the
# BFM library on top of that.
TB_BUILD_SRCS = $(TB_LIB_SRCS)

# VCS flags
VCS_FLAGS = -full64 \
            -sverilog \
            +v2k \
            -debug_access+all \
            -timescale=1ns/1ps \
            -kdb \
						+define+VCS

# Build targets
.PHONY: all clean run simv

all: simv

simv: $(RTL_FILELIST) $(TB_LIB_SRCS)
	@mkdir -p $(SIM_DIR)
	APB_DEC_GEN_HOME=$(APB_DEC_GEN_HOME) $(VCS) $(VCS_FLAGS) -f $(RTL_FILELIST) $(TB_BUILD_SRCS) -o $(SIM_DIR)/simv

# Run simulation
run: simv
	cd $(SIM_DIR) && ./simv +fsdb+file=$(SIM_DIR)/wave.fsdb

# Run with GUI (Verdi)
verdi: simv
	cd $(SIM_DIR) && ./simv +fsdb+file=$(SIM_DIR)/wave.fsdb
	verdi -ssf $(SIM_DIR)/wave.fsdb &

# Clean build artifacts
clean:
	rm -rf csrc simv DVEfiles AN.DB *.fsdb *.vcd *.log simv.daidir
